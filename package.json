{
  "name": "buildlings",
  "version": "0.11.1",
  "private": true,
  "main": "desktop/main.cjs",
  "description": "Mischief: a transparent marker monkey with focus sessions, saved thoughts, and encouragement.",
  "scripts": {
    "postinstall": "node scripts/install-electron.cjs && node scripts/sync-roam-preview.cjs",
    "start": "node server.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/browser.cjs",
    "desktop": "electron .",
    "test:desktop": "node tests/desktop-smoke.cjs",
    "test:regressions": "node tests/desktop-regressions.cjs",
    "test:roam": "node tests/roam-browser.cjs",
    "sync:preview": "node scripts/sync-roam-preview.cjs",
    "package:desktop": "node scripts/package-desktop.cjs",
    "test:focus": "node tests/focus-browser.cjs",
    "test:overlay": "node tests/overlay-browser.cjs",
    "test:quotes": "node tests/quotes-browser.cjs",
    "test:shield-ui": "node tests/shield-ui.cjs",
    "test:extension": "node tests/shield-extension.cjs",
    "test:stability": "node tests/desktop-stability.cjs",
    "test:polish": "node tests/focus-polish.cjs",
    "test:wake": "node tests/desktop-wake.cjs",
    "test:video": "node tests/desktop-video.cjs",
    "test:play": "node tests/play-browser.cjs",
    "test:performance": "node tests/render-performance.cjs",
    "package:modified": "node scripts/package-modified-release.cjs",
    "test:timer-music": "node tests/timer-music-browser.cjs",
    "test:modified-desktop": "node tests/modified-desktop.cjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.7.0",
    "playwright": "1.62.1",
    "three": "0.186.1"
  },
  "engines": {
    "node": ">=24"
  }
}
